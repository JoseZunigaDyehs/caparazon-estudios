---
import { Image, type ImageMetadata } from "astro:assets";

interface Props {
  visual: {
    title: string;
    heading: string;
    body: string;
    items: {
      label: string;
      value: string;
      col?: "left" | "right";
      highlight?: boolean;
    }[];
    features: string[];
    image?: ImageMetadata;
    imageAlt?: string;
    imageDevice?: "desktop" | "mobile";
  };
}

const { visual } = Astro.props;

const assignedLeft = visual.items.filter((i) => i.col === "left");
const assignedRight = visual.items.filter((i) => i.col === "right");
const unassigned = visual.items.filter((i) => !i.col);

// Distribuye los items sin columna: primero completa la izquierda hasta 2,
// el resto va a la derecha para mantener el diseño escalonado.
for (const item of unassigned) {
  if (assignedLeft.length < 2) {
    assignedLeft.push(item);
  } else {
    assignedRight.push(item);
  }
}
---

<section class="max-w-6xl mx-auto">
  <div
    class="bg-brand-card/20 border border-brand-border rounded-[2.5rem] p-8 md:p-16 relative overflow-hidden"
  >
    <!-- Grid decorativo de fondo -->
    <div
      class="absolute inset-0 opacity-[0.03] pointer-events-none"
      style="background-image: radial-gradient(var(--color-brand-text-main) 1px, transparent 1px); background-size: 24px 24px;"
    >
    </div>

    <div class="relative z-10">
      <div class="flex items-center justify-between mb-8 md:mb-12">
        <h2
          class="text-sm font-mono text-brand-text-muted uppercase tracking-[0.3em]"
        >
          {visual.title}
        </h2>
      </div>

      <div class="grid lg:grid-cols-2 gap-8 md:gap-16 items-center">
        <div class="grid grid-cols-2 gap-4">
          <div class="space-y-4">
            {
              assignedLeft.map((item) => (
                <div
                  class={`p-4 bg-brand-surface border rounded-xl text-center ${item.highlight ? "border-brand-primary/30 shadow-[0_0_20px_rgba(0,196,159,0.1)]" : "border-brand-border"}`}
                >
                  <span class="block text-[10px] font-mono text-brand-primary mb-1 uppercase">
                    {item.label}
                  </span>
                  <span class="text-xs font-bold">{item.value}</span>
                </div>
              ))
            }
          </div>
          <div class="space-y-4 pt-8">
            {
              assignedRight.map((item) => (
                <div
                  class={`p-4 bg-brand-surface border rounded-xl text-center ${item.highlight ? "border-brand-primary/30 shadow-[0_0_20px_rgba(0,196,159,0.1)]" : "border-brand-border"}`}
                >
                  <span class="block text-[10px] font-mono text-brand-primary mb-1 uppercase">
                    {item.label}
                  </span>
                  <span class="text-xs font-bold">{item.value}</span>
                </div>
              ))
            }
          </div>
        </div>

        <div>
          <h3 class="text-2xl md:text-3xl font-bold mb-6">
            {visual.heading}
          </h3>
          <p class="text-brand-text-muted leading-relaxed mb-8">
            {visual.body}
          </p>
          <ul class="space-y-4">
            {
              visual.features.map((item) => (
                <li class="flex items-start gap-3 text-xs font-mono text-brand-text-muted uppercase tracking-wider">
                  <span class="w-1.5 h-1.5 rounded-full bg-brand-primary mt-1" />
                  {item}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
