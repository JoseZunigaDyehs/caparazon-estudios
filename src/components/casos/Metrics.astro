---
interface Props {
  metrics: {
    label: string;
    value: string;
    desc: string;
    highlight?: boolean;
  }[];
}

const { metrics } = Astro.props;
---

<section class="max-w-6xl mx-auto">
  <div class="text-center mb-8 md:mb-16">
    <h2
      class="text-sm font-mono text-brand-text-muted uppercase tracking-[0.4em]"
    >
      Métricas de Impacto
    </h2>
  </div>

  <div class="grid md:grid-cols-3 gap-6">
    {
      metrics.map((m) => (
        <div class="p-12 bg-brand-card/20 border border-brand-border rounded-[2rem] text-center hover:border-brand-primary/30 transition-colors group">
          <div
            class={`text-4xl md:text-5xl font-bold mb-2 md:mb-4 transition-transform group-hover:scale-110 ${m.highlight ? "text-brand-primary" : "text-brand-text-main"}`}
          >
            {m.value}
          </div>
          <div class="text-[10px] font-mono text-brand-primary uppercase tracking-widest mb-4">
            {m.label}
          </div>
          <p class="text-sm text-brand-text-muted leading-relaxed">{m.desc}</p>
        </div>
      ))
    }
  </div>
</section>
