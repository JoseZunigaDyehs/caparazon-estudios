---
interface Props {
  problem: {
    title: string;
    body: string;
  };
  solution: {
    title: string;
    body: string;
  };
}

const { problem, solution } = Astro.props;
---

<section class="max-w-6xl mx-auto grid md:grid-cols-2 gap-8">
  <div
    class="p-6 py-8 md:p-12 bg-brand-card/30 border border-brand-border rounded-3xl relative overflow-hidden group"
  >
    <div
      class="absolute top-8 right-8 text-brand-border opacity-20 group-hover:opacity-40 transition-opacity"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="w-12 h-12"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        ><path
          d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"
        ></path><path d="M12 9v4"></path><path d="M12 17h.01"></path></svg
      >
    </div>
    <h2
      class="inline-flex items-center gap-2 text-sm font-mono text-brand-text-muted uppercase tracking-[0.2em] mb-8"
    >
      <span class="w-1.5 h-1.5 rounded-full bg-red-500/50"></span>
      {problem.title}
    </h2>
    <p class="text-brand-text-main leading-relaxed">
      {problem.body}
    </p>
  </div>

  <div
    class="p-6 py-8 md:p-12 bg-brand-card/50 border border-brand-primary/30 rounded-3xl relative overflow-hidden group shadow-[0_0_50px_rgba(0,196,159,0.05)]"
  >
    <div
      class="absolute top-8 right-8 text-brand-primary opacity-20 group-hover:opacity-40 transition-opacity"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="w-12 h-12"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        ><path
          d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.77 3.77ZM12 12l-6 6"
        ></path></svg
      >
    </div>
    <h2
      class="inline-flex items-center gap-2 text-sm font-mono text-brand-primary uppercase tracking-[0.2em] mb-8"
    >
      <span class="w-1.5 h-1.5 rounded-full bg-brand-primary animate-pulse"
      ></span>
      {solution.title}
    </h2>
    <p class="text-brand-text-main leading-relaxed">
      {solution.body}
    </p>
  </div>
</section>
