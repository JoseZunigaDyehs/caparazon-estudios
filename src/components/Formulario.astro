---
import Wizard from "./wizard/Wizard.astro";
import { cotizacionSteps, contactFields } from "../data/cotizacion";

const API_URL = `${import.meta.env.PUBLIC_WORKER_API || ""}/api/cotizar`;
---

<section class="px-6 pt-9" id="cotizar">
  <div class="max-w-6xl mx-auto text-center mb-16">
    <h2
      class="text-4xl md:text-5xl font-bold mb-4
    timeline-view animate-fade-in-up animate-range-[entry_100%_entry_800%]"
    >
      Inicia el Blindaje de tu Negocio
    </h2>
    <p
      class="text-brand-text-muted text-lg max-w-xl mx-auto
    timeline-view animate-fade-in-up animate-range-[entry_100%_entry_600%]"
    >
      Responde 4 preguntas rápidas para evaluar la viabilidad técnica de tu
      proyecto.
    </p>
  </div>

  <div
    class="max-w-4xl mx-auto
  timeline-view animate-fade-in-up animate-range-[entry_10%_entry_100%]"
  >
    <Wizard
      steps={cotizacionSteps}
      contactFields={contactFields}
      totalSteps={5}
      successTitle="¡Cotización enviada!"
      successMessage="Revisaremos tu proyecto y te contactaremos por WhatsApp o correo en las próximas 24 horas hábiles."
      resetLabel="Enviar otra cotización"
    />
  </div>
</section>

<script>
  declare global {
    interface Window {
      trackEvent?: (
        eventName: string,
        params?: Record<string, unknown>,
      ) => void;
    }
  }

  const API_URL = `${import.meta.env.PUBLIC_WORKER_API || ""}/api/cotizar`;

  if (!import.meta.env.PUBLIC_WORKER_API) {
    console.warn(
      "Formulario de cotización: PUBLIC_WORKER_API no está definida.",
    );
  }

  document.addEventListener("wizard:submit", async (e: Event) => {
    const target = e.target as HTMLElement | null;
    const root = target?.closest<HTMLElement>("[data-wizard-root]");
    if (!root) return;

    const payload = (e as CustomEvent).detail;

    try {
      const response = await fetch(API_URL, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify(payload),
      });

      const data = await response.json().catch(() => ({}));

      if (!response.ok) {
        throw new Error(
          data.error || "Ocurrió un error al enviar la cotización.",
        );
      }

      if (typeof window.trackEvent === "function") {
        window.trackEvent("generate_lead", {
          currency: "CLP",
          value: payload.inversion || "no especificado",
          event_category: "cotizacion",
          event_label: payload.objetivo || "general",
        });
      }

      root.dispatchEvent(new CustomEvent("wizard:success"));
    } catch (err) {
      root.dispatchEvent(
        new CustomEvent("wizard:error", {
          detail:
            err instanceof Error
              ? err.message
              : "No pudimos enviar tu cotización. Inténtalo de nuevo más tarde.",
        }),
      );
    }
  });
</script>
