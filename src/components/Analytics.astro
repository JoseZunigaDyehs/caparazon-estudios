---
interface Props {
  gaId?: string;
  searchConsoleVerification?: string;
}

const { gaId, searchConsoleVerification: rawVerification } = Astro.props;

// Search Console a veces entrega el valor con prefijo; lo limpiamos por seguridad.
const searchConsoleVerification = rawVerification
  ?.replace(/^google-site-verification=\s*/, "")
  .trim();
---

{searchConsoleVerification && (
  <meta name="google-site-verification" content={searchConsoleVerification} />
)}

{gaId && (
  <>
    <script
      async
      src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}
    ></script>
    <script
      is:inline
      define:vars={{ gaId }}
      set:html={`
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', '${gaId}', { send_page_view: true });

        window.trackEvent = function(eventName, params) {
          gtag('event', eventName, params || {});
        };
      `}
    />
  </>
)}

{!gaId && (
  /* Analytics placeholder: añade tu Measurement ID de GA4 en Layout.astro */
  null
)}
