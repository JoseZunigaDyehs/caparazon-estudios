<script>
  function initClickTracking() {
    document.body.addEventListener("click", (e) => {
      const target = e.target.closest("[data-track-event]");
      if (!target) return;

      const eventName = target.dataset.trackEvent;
      let params = {};
      try {
        params = target.dataset.trackParams
          ? JSON.parse(target.dataset.trackParams)
          : {};
      } catch {
        params = {};
      }

      // Si es un enlace, añadimos la URL de destino como contexto extra.
      if (target instanceof HTMLAnchorElement && target.href) {
        params.href = target.href;
      }

      if (typeof window.trackEvent === "function") {
        window.trackEvent(eventName, params);
      }
    });
  }

  document.addEventListener("DOMContentLoaded", initClickTracking);
  // Soporte para Astro View Transitions.
  document.addEventListener("astro:page-load", initClickTracking);
</script>
